# Director LLM: any OpenAI-compatible self-hosted server.
# Lightweight profile:
CINEQO_DIRECTOR_MODEL=Qwen/Qwen3-4B
# High-quality profile when a large GPU server is available:
# CINEQO_DIRECTOR_MODEL=mistralai/Mistral-Small-4-119B-2603-NVFP4
CINEQO_DIRECTOR_BASE_URL=http://director:8000/v1
CINEQO_DIRECTOR_API_KEY=local-open-model

# Model workers
CINEQO_WHISPER_URL=http://whisper:8011
CINEQO_WAN_URL=http://wan:8012
CINEQO_MUSETALK_URL=http://musetalk:8013
CINEQO_IDENTITY_URL=

# Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cuda

# Wan
WAN_CKPT_DIR=/models/Wan2.2-T2V-A14B
WAN_TASK=t2v-A14B

# API
CINEQO_CORS_ORIGINS=*
CINEQO_WEB_RESULTS=8
