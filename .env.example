# Cineqo open-model runtime

# Director LLM (OpenAI-compatible vLLM endpoint)
CINEQO_DIRECTOR_MODEL=Qwen/Qwen3-4B
# Optional high-quality profile on a much larger/multi-GPU server:
# CINEQO_DIRECTOR_MODEL=mistralai/Mistral-Small-4-119B-2603
CINEQO_DIRECTOR_BASE_URL=http://director:8000/v1
CINEQO_DIRECTOR_API_KEY=local-open-model

# Internal model workers
CINEQO_WHISPER_URL=http://whisper:8011
CINEQO_WAN_URL=http://wan:8012
CINEQO_MUSETALK_URL=http://musetalk:8013
CINEQO_IDENTITY_URL=http://identity:8014
CINEQO_SHARED_ROOT=/shared

# Whisper: chat microphone + song transcription
WHISPER_MODEL=small
WHISPER_DEVICE=cuda

# Wan 2.2 TI2V-5B: text-to-video and image-to-video on a practical single GPU
WAN_CKPT_DIR=/models/Wan2.2-TI2V-5B
WAN_TASK=ti2v-5B
WAN_JOB_TIMEOUT=7200

# API
CINEQO_CORS_ORIGINS=*
CINEQO_WEB_RESULTS=8

# Host filesystem layout expected by docker-compose:
# ./models/hf              vLLM/Hugging Face cache
# ./models/wan/Wan2.2-TI2V-5B
# ./models/musetalk/musetalkV15/unet.pth
# ./models/musetalk/musetalkV15/musetalk.json
# ./models/triposr-cache
# ./runtime/shared         uploads + generated video + lip-sync + 3D outputs
