{
  "schema_version": 1,
  "project": "Cineqo",
  "policy": {
    "ai_components_must_be_open_source": true,
    "preferred_licenses": ["Apache-2.0", "MIT", "BSD-2-Clause", "BSD-3-Clause"],
    "model_weights_committed": false,
    "reject_custom_restrictive_model_licenses": true
  },
  "components": [
    {
      "id": "wan2.2",
      "role": "video-generation",
      "upstream": "https://github.com/Wan-Video/Wan2.2.git",
      "ref": "main",
      "destination": "third_party/video/Wan2.2",
      "license": "Apache-2.0",
      "include_in_import": true,
      "notes": "Source code only. Model weights stay external. Ref is pinned to an immutable commit by the import workflow."
    },
    {
      "id": "musetalk",
      "role": "lip-sync",
      "upstream": "https://github.com/TMElyralab/MuseTalk.git",
      "ref": "main",
      "destination": "third_party/lipsync/MuseTalk",
      "license": "MIT",
      "include_in_import": true,
      "notes": "Source import only. Checkpoints stay external and retain upstream notices."
    },
    {
      "id": "whisper",
      "role": "speech-transcription",
      "upstream": "https://github.com/openai/whisper.git",
      "ref": "main",
      "destination": "third_party/audio/whisper",
      "license": "MIT",
      "include_in_import": true,
      "notes": "Used for chat voice input, transcription and lyric timing assistance; never for music generation."
    },
    {
      "id": "qwen3-4b",
      "role": "director-lightweight",
      "upstream": "https://huggingface.co/Qwen/Qwen3-4B",
      "ref": "main",
      "destination": null,
      "license": "Apache-2.0",
      "include_in_import": false,
      "notes": "Default lighter self-hosted Director profile. Weights stay external."
    },
    {
      "id": "mistral-small-4",
      "role": "director-high-quality",
      "upstream": "https://huggingface.co/mistralai/Mistral-Small-4-119B-2603",
      "ref": "main",
      "destination": null,
      "license": "Apache-2.0",
      "include_in_import": false,
      "notes": "High-quality Director/research/planning profile. Weights stay external because the checkpoint is very large."
    },
    {
      "id": "vllm",
      "role": "open-model-serving",
      "upstream": "https://github.com/vllm-project/vllm.git",
      "ref": "main",
      "destination": null,
      "license": "Apache-2.0",
      "include_in_import": false,
      "notes": "OpenAI-compatible self-hosted inference server for the Director model. Pulled as a container/runtime dependency rather than vendored."
    }
  ],
  "excluded": [
    {
      "id": "hunyuanvideo",
      "reason": "Custom community model license with territorial restrictions; excluded under Cineqo's strict open-source policy."
    },
    {
      "id": "flux1-dev-family",
      "reason": "Non-commercial/custom model-license restrictions on dev-family weights; excluded from the approved set."
    }
  ],
  "workflow_trigger_revision": 2
}
